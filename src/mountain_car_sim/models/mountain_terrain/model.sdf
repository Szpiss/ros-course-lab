<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="mountain_terrain">
    <static>true</static>

    <!-- 山地底座：比 ground_plane 更深的土色区域，突出实验场地边界。 -->
    <link name="base_ground">
      <pose>0 0 0.015 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>10.5 5.5 0.03</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>10.5 5.5 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.33 0.25 0.16 1</ambient>
          <diffuse>0.46 0.35 0.21 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 第一段上坡，坡度较缓，适合小车从入口驶入。 -->
    <link name="lower_ramp">
      <pose>-2.05 0 0.42 0 -0.17 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>4.0 2.2 0.22</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.8</mu>
              <mu2>1.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>4.0 2.2 0.22</size>
          </box>
        </geometry>
        <material>
          <ambient>0.25 0.38 0.20 1</ambient>
          <diffuse>0.32 0.52 0.25 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 中间平台，便于观察小车在山路上稳定行驶。 -->
    <link name="middle_plateau">
      <pose>0.65 0 0.72 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>2.1 2.35 0.24</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.8</mu>
              <mu2>1.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>2.1 2.35 0.24</size>
          </box>
        </geometry>
        <material>
          <ambient>0.28 0.42 0.22 1</ambient>
          <diffuse>0.35 0.58 0.28 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 第二段上坡，连接到终点旗帜所在高处。 -->
    <link name="upper_ramp">
      <pose>2.65 0 0.88 0 -0.12 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>3.0 2.05 0.22</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.8</mu>
              <mu2>1.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>3.0 2.05 0.22</size>
          </box>
        </geometry>
        <material>
          <ambient>0.22 0.34 0.18 1</ambient>
          <diffuse>0.29 0.48 0.23 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 两侧山脊只作为视觉和边界，不要求小车驶上去。 -->
    <link name="left_ridge">
      <pose>0 1.95 0.48 0 0.08 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>7.0 0.55 0.75</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>7.0 0.55 0.75</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20 0.29 0.16 1</ambient>
          <diffuse>0.26 0.39 0.21 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_ridge">
      <pose>0 -1.95 0.42 0 -0.08 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>7.0 0.55 0.65</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>7.0 0.55 0.65</size>
          </box>
        </geometry>
        <material>
          <ambient>0.21 0.30 0.17 1</ambient>
          <diffuse>0.27 0.41 0.22 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 山顶平台，为检查点提供稳定摆放位置。 -->
    <link name="summit">
      <pose>4.45 0 1.02 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>1.5 2.0 0.20</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>1.5 2.0 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.30 0.46 0.24 1</ambient>
          <diffuse>0.38 0.63 0.30 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
