<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="mountain_terrain">
    <static>true</static>

    <!--
      山地主体使用程序化网格 mesh，而不是少量 box。
      mesh 中包含主坡度、两侧山脊、中央蛇形车道和小幅起伏，展示效果更接近山地。
    -->
    <link name="terrain_mesh">
      <pose>0 0 0 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://mountain_terrain/meshes/mountain_terrain.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://mountain_terrain/meshes/mountain_terrain.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.23 0.38 0.20 1</ambient>
          <diffuse>0.33 0.55 0.26 1</diffuse>
          <specular>0.04 0.04 0.03 1</specular>
        </material>
      </visual>
    </link>

    <!-- 贴合 mesh 高度的蛇形土路，只作为视觉层，帮助展示山地路线。 -->
    <link name="trail_visual">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://mountain_terrain/meshes/mountain_trail.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.36 0.22 0.10 1</ambient>
          <diffuse>0.55 0.34 0.16 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 山地外圈土色底座，帮助从 Gazebo 网格背景中区分实验场地范围。 -->
    <link name="terrain_base">
      <pose>0 0 -0.035 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>10.8 6.3 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>10.8 6.3 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.28 0.20 0.12 1</ambient>
          <diffuse>0.42 0.31 0.18 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 两侧低矮护栏用于强调山路边界，也避免小车演示时跑出场景。 -->
    <link name="left_boundary">
      <pose>0 3.08 0.42 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>10.4 0.16 0.55</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>10.4 0.16 0.55</size>
          </box>
        </geometry>
        <material>
          <ambient>0.18 0.25 0.15 1</ambient>
          <diffuse>0.23 0.34 0.20 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_boundary">
      <pose>0 -3.08 0.42 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>10.4 0.16 0.55</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>10.4 0.16 0.55</size>
          </box>
        </geometry>
        <material>
          <ambient>0.18 0.25 0.15 1</ambient>
          <diffuse>0.23 0.34 0.20 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
