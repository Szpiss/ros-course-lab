<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="checkpoint_flag">
    <static>true</static>

    <link name="flag_link">
      <!-- 旗杆底座，提高视觉稳定感。 -->
      <collision name="base_collision">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <collision name="pole_collision">
        <pose>0 0 0.72 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>1.36</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="pole_visual">
        <pose>0 0 0.72 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>1.36</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.78 0.78 0.78 1</ambient>
          <diffuse>0.90 0.90 0.88 1</diffuse>
        </material>
      </visual>

      <!-- 红色旗面用于标识终点检查点。 -->
      <collision name="flag_collision">
        <pose>0 0.35 1.18 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.70 0.34</size>
          </box>
        </geometry>
      </collision>
      <visual name="flag_visual">
        <pose>0 0.35 1.18 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.70 0.34</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.06 0.05 1</ambient>
          <diffuse>1.00 0.08 0.06 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
