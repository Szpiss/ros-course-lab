<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="mountain_city_transition">
    <static>true</static>

    <!-- Layered road surface: dirt trail fades into a wider asphalt city entry. -->
    <link name="dirt_exit_patch">
      <pose>4.85 0 0.075 0 0 0</pose>
      <collision name="collision"><geometry><box><size>1.80 1.22 0.035</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>1.80 1.22 0.035</size></box></geometry>
        <material><ambient>0.34 0.24 0.13 1</ambient><diffuse>0.34 0.24 0.13 1</diffuse></material>
      </visual>
    </link>

    <link name="mixed_gravel_patch">
      <pose>5.85 0 0.085 0 0 0</pose>
      <collision name="collision"><geometry><box><size>1.65 1.42 0.035</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>1.65 1.42 0.035</size></box></geometry>
        <material><ambient>0.20 0.18 0.15 1</ambient><diffuse>0.20 0.18 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="asphalt_entry_patch">
      <pose>6.95 0 0.095 0 0 0</pose>
      <collision name="collision"><geometry><box><size>2.15 1.72 0.038</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>2.15 1.72 0.038</size></box></geometry>
        <material><ambient>0.055 0.058 0.060 1</ambient><diffuse>0.055 0.058 0.060 1</diffuse></material>
      </visual>
    </link>

    <link name="city_entry_flare">
      <pose>7.85 0 0.105 0 0 0</pose>
      <collision name="collision"><geometry><box><size>1.25 2.18 0.035</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>1.25 2.18 0.035</size></box></geometry>
        <material><ambient>0.045 0.048 0.050 1</ambient><diffuse>0.045 0.048 0.050 1</diffuse></material>
      </visual>
    </link>

    <!-- Shoulders hide the hard seam between the mountain mesh and the city road. -->
    <link name="north_earth_shoulder">
      <pose>6.00 1.00 0.11 0 0 0.03</pose>
      <visual name="visual">
        <geometry><box><size>3.60 0.46 0.07</size></box></geometry>
        <material><ambient>0.26 0.22 0.15 1</ambient><diffuse>0.26 0.22 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="south_earth_shoulder">
      <pose>6.00 -1.00 0.11 0 0 -0.03</pose>
      <visual name="visual">
        <geometry><box><size>3.60 0.46 0.07</size></box></geometry>
        <material><ambient>0.26 0.22 0.15 1</ambient><diffuse>0.26 0.22 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="north_city_curb">
      <pose>7.35 1.28 0.16 0 0 0</pose>
      <collision name="collision"><geometry><box><size>2.15 0.16 0.16</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>2.15 0.16 0.16</size></box></geometry>
        <material><ambient>0.62 0.62 0.58 1</ambient><diffuse>0.62 0.62 0.58 1</diffuse></material>
      </visual>
    </link>

    <link name="south_city_curb">
      <pose>7.35 -1.28 0.16 0 0 0</pose>
      <collision name="collision"><geometry><box><size>2.15 0.16 0.16</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>2.15 0.16 0.16</size></box></geometry>
        <material><ambient>0.62 0.62 0.58 1</ambient><diffuse>0.62 0.62 0.58 1</diffuse></material>
      </visual>
    </link>

    <!-- Retaining walls and mixed guard rails bridge the visual language of mountain and city. -->
    <link name="north_retaining_wall">
      <pose>5.70 1.42 0.42 0 0 0.02</pose>
      <collision name="collision"><geometry><box><size>2.25 0.20 0.58</size></box></geometry></collision>
      <visual name="wall">
        <geometry><box><size>2.25 0.20 0.58</size></box></geometry>
        <material><ambient>0.36 0.35 0.32 1</ambient><diffuse>0.36 0.35 0.32 1</diffuse></material>
      </visual>
      <visual name="cap"><pose>0 0 0.34 0 0 0</pose><geometry><box><size>2.35 0.26 0.08</size></box></geometry><material><ambient>0.52 0.51 0.48 1</ambient><diffuse>0.52 0.51 0.48 1</diffuse></material></visual>
    </link>

    <link name="south_retaining_wall">
      <pose>5.70 -1.42 0.42 0 0 -0.02</pose>
      <collision name="collision"><geometry><box><size>2.25 0.20 0.58</size></box></geometry></collision>
      <visual name="wall">
        <geometry><box><size>2.25 0.20 0.58</size></box></geometry>
        <material><ambient>0.36 0.35 0.32 1</ambient><diffuse>0.36 0.35 0.32 1</diffuse></material>
      </visual>
      <visual name="cap"><pose>0 0 0.34 0 0 0</pose><geometry><box><size>2.35 0.26 0.08</size></box></geometry><material><ambient>0.52 0.51 0.48 1</ambient><diffuse>0.52 0.51 0.48 1</diffuse></material></visual>
    </link>

    <link name="north_wood_to_metal_rail">
      <pose>6.95 1.05 0.50 0 0 0</pose>
      <visual name="wood_part"><pose>-0.70 0 0 0 0 0</pose><geometry><box><size>1.05 0.07 0.12</size></box></geometry><material><ambient>0.46 0.28 0.13 1</ambient><diffuse>0.46 0.28 0.13 1</diffuse></material></visual>
      <visual name="metal_part"><pose>0.58 0 0 0 0 0</pose><geometry><box><size>1.25 0.07 0.12</size></box></geometry><material><ambient>0.78 0.78 0.72 1</ambient><diffuse>0.78 0.78 0.72 1</diffuse></material></visual>
      <visual name="post_1"><pose>-1.10 0 -0.24 0 0 0</pose><geometry><box><size>0.07 0.07 0.48</size></box></geometry><material><ambient>0.38 0.24 0.12 1</ambient><diffuse>0.38 0.24 0.12 1</diffuse></material></visual>
      <visual name="post_2"><pose>0.00 0 -0.24 0 0 0</pose><geometry><box><size>0.07 0.07 0.48</size></box></geometry><material><ambient>0.58 0.58 0.54 1</ambient><diffuse>0.58 0.58 0.54 1</diffuse></material></visual>
      <visual name="post_3"><pose>1.10 0 -0.24 0 0 0</pose><geometry><box><size>0.07 0.07 0.48</size></box></geometry><material><ambient>0.58 0.58 0.54 1</ambient><diffuse>0.58 0.58 0.54 1</diffuse></material></visual>
    </link>

    <link name="south_wood_to_metal_rail">
      <pose>6.95 -1.05 0.50 0 0 0</pose>
      <visual name="wood_part"><pose>-0.70 0 0 0 0 0</pose><geometry><box><size>1.05 0.07 0.12</size></box></geometry><material><ambient>0.46 0.28 0.13 1</ambient><diffuse>0.46 0.28 0.13 1</diffuse></material></visual>
      <visual name="metal_part"><pose>0.58 0 0 0 0 0</pose><geometry><box><size>1.25 0.07 0.12</size></box></geometry><material><ambient>0.78 0.78 0.72 1</ambient><diffuse>0.78 0.78 0.72 1</diffuse></material></visual>
      <visual name="post_1"><pose>-1.10 0 -0.24 0 0 0</pose><geometry><box><size>0.07 0.07 0.48</size></box></geometry><material><ambient>0.38 0.24 0.12 1</ambient><diffuse>0.38 0.24 0.12 1</diffuse></material></visual>
      <visual name="post_2"><pose>0.00 0 -0.24 0 0 0</pose><geometry><box><size>0.07 0.07 0.48</size></box></geometry><material><ambient>0.58 0.58 0.54 1</ambient><diffuse>0.58 0.58 0.54 1</diffuse></material></visual>
      <visual name="post_3"><pose>1.10 0 -0.24 0 0 0</pose><geometry><box><size>0.07 0.07 0.48</size></box></geometry><material><ambient>0.58 0.58 0.54 1</ambient><diffuse>0.58 0.58 0.54 1</diffuse></material></visual>
    </link>

    <!-- Lane markings fade in gradually as the trail becomes city road. -->
    <link name="dashed_center_intro_1">
      <pose>5.70 0 0.145 0 0 0</pose>
      <visual name="visual"><geometry><box><size>0.42 0.06 0.018</size></box></geometry><material><ambient>0.95 0.78 0.12 1</ambient><diffuse>0.95 0.78 0.12 1</diffuse></material></visual>
    </link>

    <link name="dashed_center_intro_2">
      <pose>6.60 0 0.150 0 0 0</pose>
      <visual name="visual"><geometry><box><size>0.62 0.07 0.018</size></box></geometry><material><ambient>0.98 0.82 0.12 1</ambient><diffuse>0.98 0.82 0.12 1</diffuse></material></visual>
    </link>

    <link name="dashed_center_intro_3">
      <pose>7.55 0 0.155 0 0 0</pose>
      <visual name="visual"><geometry><box><size>0.78 0.08 0.018</size></box></geometry><material><ambient>1.00 0.86 0.12 1</ambient><diffuse>1.00 0.86 0.12 1</diffuse></material></visual>
    </link>

    <!-- Gateway element marks the mountain-city boundary without feeling like a hard cut. -->
    <link name="mountain_city_gateway">
      <pose>7.90 0 0 0 0 0</pose>
      <visual name="left_post"><pose>0 1.45 0.92 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>1.84</length></cylinder></geometry><material><ambient>0.26 0.26 0.24 1</ambient><diffuse>0.26 0.26 0.24 1</diffuse></material></visual>
      <visual name="right_post"><pose>0 -1.45 0.92 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>1.84</length></cylinder></geometry><material><ambient>0.26 0.26 0.24 1</ambient><diffuse>0.26 0.26 0.24 1</diffuse></material></visual>
      <visual name="top_beam"><pose>0 0 1.82 0 1.5708 0</pose><geometry><cylinder><radius>0.055</radius><length>2.92</length></cylinder></geometry><material><ambient>0.26 0.26 0.24 1</ambient><diffuse>0.26 0.26 0.24 1</diffuse></material></visual>
      <visual name="sign_board"><pose>0 -0.02 1.58 0 0 0</pose><geometry><box><size>0.18 1.35 0.28</size></box></geometry><material><ambient>0.08 0.34 0.78 1</ambient><diffuse>0.08 0.34 0.78 1</diffuse></material></visual>
      <visual name="sign_stripe"><pose>0.10 -0.02 1.58 0 0 0</pose><geometry><box><size>0.05 1.05 0.07</size></box></geometry><material><ambient>0.95 0.95 0.82 1</ambient><diffuse>0.95 0.95 0.82 1</diffuse></material></visual>
    </link>

    <!-- Mixed natural and urban roadside objects. -->
    <link name="transition_pine_and_lamp">
      <pose>7.35 1.85 0 0 0 0</pose>
      <visual name="pine_trunk"><pose>-0.55 0 0.36 0 0 0</pose><geometry><cylinder><radius>0.08</radius><length>0.72</length></cylinder></geometry><material><ambient>0.28 0.16 0.08 1</ambient><diffuse>0.28 0.16 0.08 1</diffuse></material></visual>
      <visual name="pine_crown"><pose>-0.55 0 0.92 0 0 0</pose><geometry><sphere><radius>0.36</radius></sphere></geometry><material><ambient>0.06 0.34 0.13 1</ambient><diffuse>0.06 0.34 0.13 1</diffuse></material></visual>
      <visual name="lamp_pole"><pose>0.55 0 0.86 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>1.72</length></cylinder></geometry><material><ambient>0.16 0.16 0.16 1</ambient><diffuse>0.16 0.16 0.16 1</diffuse></material></visual>
      <visual name="lamp_head"><pose>0.68 0 1.74 0 0 0</pose><geometry><box><size>0.28 0.16 0.10</size></box></geometry><material><ambient>1.0 0.82 0.36 1</ambient><diffuse>1.0 0.82 0.36 1</diffuse></material></visual>
    </link>

    <link name="transition_bushes_south">
      <pose>7.05 -1.82 0.14 0 0 0</pose>
      <visual name="bush_1"><pose>-0.45 0 0.12 0 0 0</pose><geometry><sphere><radius>0.20</radius></sphere></geometry><material><ambient>0.12 0.40 0.12 1</ambient><diffuse>0.12 0.40 0.12 1</diffuse></material></visual>
      <visual name="bush_2"><pose>-0.05 0.06 0.14 0 0 0</pose><geometry><sphere><radius>0.23</radius></sphere></geometry><material><ambient>0.10 0.34 0.10 1</ambient><diffuse>0.10 0.34 0.10 1</diffuse></material></visual>
      <visual name="bush_3"><pose>0.42 -0.02 0.12 0 0 0</pose><geometry><sphere><radius>0.20</radius></sphere></geometry><material><ambient>0.14 0.42 0.14 1</ambient><diffuse>0.14 0.42 0.14 1</diffuse></material></visual>
    </link>

    <link name="transition_service_box">
      <pose>8.45 -1.55 0.24 0 0 0</pose>
      <visual name="box"><geometry><box><size>0.42 0.28 0.48</size></box></geometry><material><ambient>0.12 0.32 0.56 1</ambient><diffuse>0.12 0.32 0.56 1</diffuse></material></visual>
      <visual name="panel"><pose>0 -0.145 0.04 0 0 0</pose><geometry><box><size>0.28 0.025 0.18</size></box></geometry><material><ambient>0.85 0.90 0.92 1</ambient><diffuse>0.85 0.90 0.92 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
