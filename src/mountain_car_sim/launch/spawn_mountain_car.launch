<launch>
  <arg name="model_name" default="mountain_car" />
  <arg name="x" default="-4.0" />
  <arg name="y" default="0.0" />
  <arg name="z" default="0.45" />
  <arg name="yaw" default="0.0" />

  <!-- 使用 xacro 生成 robot_description，便于后续调整小车尺寸和惯量。 -->
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find mountain_car_sim)/urdf/mountain_car.xacro'" />

  <!--
    将四轮小车生成到 Gazebo 中。
    先删除旧的同名模型，避免重复启动时报 entity already exists。
  -->
  <node name="reset_spawn_mountain_car" pkg="mountain_car_sim" type="reset_spawn_model.py"
        output="screen">
    <param name="model_name" value="$(arg model_name)" />
    <param name="x" value="$(arg x)" />
    <param name="y" value="$(arg y)" />
    <param name="z" value="$(arg z)" />
    <param name="yaw" value="$(arg yaw)" />
  </node>

  <!-- 发布 TF，便于在 RViz 或实验报告中说明 base_link/车轮关系。 -->
  <node name="mountain_car_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"
        output="screen" />
</launch>
